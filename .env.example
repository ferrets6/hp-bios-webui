# Copy this file to .env in the project root and fill in the real values.
# .env is gitignored - never commit it.

# IP/hostname of the machine that has the HP hp-bioscfg sysfs interface
NAS_HOST=<your-nas-ip-or-hostname>
NAS_USER=<your-ssh-username>
NAS_SSH_PORT=22

# Path (on the Docker host's filesystem, not inside the container) to the
# dedicated private key used by the container to reach NAS_HOST.
#
# Generate it with (from the project root):
#   ssh-keygen -t ed25519 -f ./id_ed25519 -N "" -C "bios-webui@$(hostname)"
# This creates ./id_ed25519 (private, gitignored) and ./id_ed25519.pub.
# Then append the .pub half to ~<your-ssh-username>/.ssh/authorized_keys
# on the target machine (NAS_HOST) - e.g.:
#   ssh-copy-id -i ./id_ed25519.pub <your-ssh-username>@<your-nas-ip-or-hostname>
# An empty passphrase (-N "") is required since the container reads the
# key non-interactively.
NAS_SSH_KEY_HOST_PATH=/home/pi/bios-webui/id_ed25519

# Path to the control script on the NAS itself (see README's
# "One-time NAS setup" section)
NAS_CTL_PATH=/mnt/apps-temp/bios-webui/bios-webui-ctl

# Local port to expose the web UI on
WEBUI_PORT=8088
