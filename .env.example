# Copy this file to .env on the Raspberry Pi (or wherever you run docker compose)
# and fill in the real values. .env is gitignored - never commit it.

# IP/hostname of the machine that has the HP hp-bioscfg sysfs interface
NAS_HOST=<your-nas-ip-or-hostname>
NAS_USER=<your-ssh-username>
NAS_SSH_PORT=22

# Path (on the Pi's filesystem, not inside the container) to the private key
# generated for this app. See deploy/nas_setup.sh for how it's provisioned.
NAS_SSH_KEY_HOST_PATH=/home/pi/bios-webui/id_ed25519

# Path to the control script on the NAS itself (see deploy/nas_setup.sh)
NAS_CTL_PATH=/mnt/apps-temp/bios-webui/bios-webui-ctl

# Local port to expose the web UI on
WEBUI_PORT=8088
